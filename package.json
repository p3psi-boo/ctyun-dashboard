{
  "name": "ctyun-dashboard",
  "version": "2.4.0",
  "description": "天翼云电脑/移动爱家/移动公众可视化多账号保活控制中心",
  "main": "server.ts",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun server.ts",
    "check": "bun tests/syntax_check.js",
    "typecheck": "tsc --noEmit",
    "test": "bun tests/syntax_check.js && bun tests/regression.test.js",
    "test:mutation": "bun tests/mutation_check.js",
    "smoke": "bun analysis/smoke_check.js",
    "verify": "bun tests/syntax_check.js && tsc --noEmit && bun tests/regression.test.js && bun tests/mutation_check.js && bun analysis/smoke_check.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
